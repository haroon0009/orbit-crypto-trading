{
  "name": "crypto-futures-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm ui",
    "build": "tsc -p tsconfig.build.json && pnpm ui:build",
    "start": "node dist/ui/server.js",
    "candles:import": "tsx src/cli/candles.ts import",
    "candles:verify": "tsx src/cli/candles.ts verify",
    "paper:data": "tsx src/cli/paper-data.ts",
    "ui": "pnpm ui:build && tsx src/ui/server.ts",
    "ui:build": "vite build --config web/vite.config.ts",
    "ui:typecheck": "tsc -p web/tsconfig.json --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test test/**/*.test.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm ui:typecheck && pnpm test",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "bullmq": "^6.3.11",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "decimal.js": "^10.6.0",
    "ioredis": "^6.0.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.49.0",
    "pg": "^8.16.3",
    "pino": "^9.9.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^8.3.1"
  }
}
